{
  "name": "focustodopro",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "electron:build": "vite build --mode electron",
    "electron:start": "electron .",
    "desktop:build": "npm run electron:build && electron-builder --win nsis --config.directories.output=release/installer && electron-builder --win portable --config.directories.output=release/portable"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@supabase/supabase-js": "^2.119.2",
    "@tailwindcss/vite": "^4.3.5",
    "electron-updater": "^6.8.11",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^2.1.9",
    "wait-on": "^9.5.1"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.focustodopro.desktop",
    "productName": "FocusToDoPro",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "!dist-electron/updates/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "artifactName": "FocusToDoPro-${version}-${arch}.${ext}",
    "publish": [
      {
        "provider": "generic",
        "url": "https://focustodopro.vercel.app/updates/windows/",
        "channel": "latest"
      }
    ]
  }
}